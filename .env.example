HOST=127.0.0.1
PORT=3001
# Required for normal development and deployment. Keep the real value only in
# an untracked .env file or the hosting provider's secret store.
DATABASE_URL=postgresql://user:password@host:5432/siteguard?sslmode=verify-full
# SQLite is reserved for isolated automated tests/rehearsals.
# SITEGUARD_ALLOW_SQLITE=true
# SQLITE_PATH=.data/siteguard.sqlite
DEMO_MODE=true
HOSTED=false
# Local testing only: skip consent checkbox and scheduled-break time gate.
# Sessions are marked local-test; hosted deployments never enable this bypass.
CHECK_IN_TEST_MODE=false
# Set strong independent secrets for hosting.
# COOKIE_SECRET=
# MEASUREMENT_TOKEN=
# Dedicated disposable PostgreSQL QA connection; never use production credentials.
# POSTGRES_TEST_DATABASE_URL=postgresql://user:password@host:5432/siteguard_test
# GEMINI_API_KEY=
# GEMINI_MODEL=verified-account-model-id
# RESEARCH_DEMO_ENABLED=true enables the local synthetic research artifact.
# RESEARCH_DEMO_ALLOW_PRESAGE=true additionally enables the local theory-demo
# override that scores real Presage summaries with that synthetic artifact.
# Both flags are forced off in production; this is not validated guidance.
# Only behind a reverse proxy that overwrites this header with the client IP
# (Fly.io: fly-client-ip). Leave unset when clients connect directly.
# CLIENT_IP_HEADER=
PRESAGE_BRIDGE_URL=http://127.0.0.1:4311
# PRESAGE_BRIDGE_TOKEN=

# Demo auth is local only. Hosted deployments must use OIDC account login.
AUTH_MODE=demo
APP_ORIGIN=http://127.0.0.1:3001
SITE_ID=local-demo
# AUTH_MODE=oidc
# OIDC_ISSUER=https://your-provider.example.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# AUTH_BOOTSTRAP_SUBJECT=provider-verified-subject
# AUTH_BOOTSTRAP_EMAIL=manager@example.com

# Backend-only shared credential for local fall-detection preview and controls.
# FALL_DETECTION_TOKEN=

# Preferred account provider. Set AUTH_MODE=supabase when these are configured.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ADMIN_EMAIL=your-admin-email@example.com
# Existing VITE_SUPABASE_URL/VITE_SUPABASE_PUBLISHABLE_KEY are accepted aliases.
# Passwords belong in Supabase, never in this file.

# Optional explicit trusted frontend origins (no wildcards).
# AUTH_ADDITIONAL_ORIGINS=http://127.0.0.1:5173
