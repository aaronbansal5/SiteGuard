// Copy to Config/Secrets.xcconfig (gitignored) for LOCAL DEVELOPMENT ONLY.
// A key set here is embedded in the built app bundle, so never distribute a
// build made with it; use Presage OAuth (PresageService-Info.plist) instead.
// Note: xcconfig treats "//" as a comment, so write URLs as https:/$()/host.
SMARTSPECTRA_API_KEY = paste-your-development-key-here
// Optional: SiteGuard web origin for the in-app support link, e.g.
// SITEGUARD_WEB_URL = http:/$()/192.168.1.20:5173
// Optional: demo reminder interval in seconds (default 60).
// SITEGUARD_CHECKIN_INTERVAL_SECONDS = 60
